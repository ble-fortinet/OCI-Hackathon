# Copy this file to .env.local and fill it in. .env.local and *.pem files are ignored by git.
# The AI advisor uses OpenAI when OPENAI_API_KEY is set, otherwise OCI Generative AI if all OCI values are set.

# --- OpenAI (simplest) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- OCI Generative AI (optional; used only when OPENAI_API_KEY is empty) ---
# OCI_TENANCY_OCID=
# OCI_USER_OCID=
# OCI_FINGERPRINT=
# OCI_COMPARTMENT_OCID=
# OCI_PRIVATE_KEY_PATH=./oci-api-key.pem
# OCI_REGION=us-chicago-1
# OCI_GENAI_MODEL=meta.llama-3.3-70b-instruct
