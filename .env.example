# Copy this file to .env.local and fill it in. .env.local and *.pem files are ignored by git.
# Values come from the OCI Console: Profile > My profile > API keys > "View configuration file".

OCI_TENANCY_OCID=ocid1.tenancy.oc1..
OCI_USER_OCID=ocid1.user.oc1..
OCI_FINGERPRINT=aa:bb:cc:...
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..   # or the tenancy OCID to use the root compartment

# Private key: give EITHER a path to the .pem file (easiest) OR the key itself.
OCI_PRIVATE_KEY_PATH=./oci-api-key.pem
# OCI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# OCI_KEY_PASSPHRASE=          # only if the key has a passphrase

# Optional
OCI_REGION=us-chicago-1
OCI_GENAI_MODEL=meta.llama-3.3-70b-instruct
